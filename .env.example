# Database (host port is 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tasklist?schema=public

# Redis (host port is 6380 to avoid clashing with a local Redis)
REDIS_HOST=localhost
REDIS_PORT=6380

# API
API_PORT=4000

# JWT (обязательно переопределите в production; минимум 32 символа)
JWT_ACCESS_SECRET=change-me-in-production

# Публичный адрес web-приложения: из него строятся share-ссылки
WEB_URL=http://localhost:3000

# Доверенный reverse proxy: число hops (1) или список адресов через запятую.
# Оставьте пустым при прямом доступе к API, иначе req.ip будет подменяться.
# TRUST_PROXY=1

# Rate limiting (TTL в миллисекундах)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
# Для локального прогона E2E: тесты логинятся много раз, лимит 5 упирается
# в 429. В production держите 5.
THROTTLE_AUTH_LIMIT=1000

# CORS / CSRF: origin'ы через запятую (в production — только свои домены)
CORS_ORIGIN=http://localhost:3000

# Refresh cookie (в production: COOKIE_SAME_SITE=strict, COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
